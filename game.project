[project]
title = GA_DefoldTest
version = 0.1
dependencies = https://github.com/britzl/defold-metrics/archive/master.zip,https://github.com/britzl/deftest/archive/refs/tags/2.9.0.zip

[bootstrap]
main_collection = /main/gameanalytics.collectionc

[input]
game_binding = /input/game.input_bindingc

[display]
width = 1280
height = 720
high_dpi = 0
fullscreen = 0
update_frequency = 0
display_profiles = /builtins/render/default.display_profilesc
vsync = 0

[physics]
scale = 0.02

[script]
shared_state = 1

[ios]
bundle_identifier = com.gameanalytics.defold

[android]
package = com.gameanalytics.defold
debuggable = 1

[osx]
bundle_identifier = com.gameanalytics.defold

[gameanalytics]
game_key_ios =
secret_key_ios =
build_ios = 0.1.0
game_key_android =
secret_key_android =
build_android = 0.1
game_key_html5 =
secret_key_html5 =
build_html5 = 0.1.0
game_key_osx =
secret_key_osx =
build_osx = 0.0.1
game_key_windows =
secret_key_windows =
build_windows = 0.1
game_key_linux =
secret_key_linux =
build_linux = 0.1
custom_dimensions_01 = ninja,samurai
custom_dimensions_02 = whale,dolphin
custom_dimensions_03 = horde,alliance
resource_currencies = gold,gems
resource_item_types = boost,lives
enable_info_log = 1
enable_verbose_log = 1
manual_initialize = 1
use_manual_session_handling = 0
auto_detect_app_version = 1
use_custom_id = 1

[library]
include_dirs = gameanalytics
