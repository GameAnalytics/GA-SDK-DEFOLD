name: "GameAnalytics"

platforms:
    arm64-ios:
        context:
            frameworks: ["AdSupport", "SystemConfiguration", "AppTrackingTransparency"]
            flags:      ["-stdlib=libc++", "-std=c++17"]
            linkFlags:  ["-ObjC"]
            libs:       ["z", "c++", "sqlite3"]
    arm64_sim-ios:
        context:
            frameworks: ["AdSupport", "SystemConfiguration", "AppTrackingTransparency"]
            flags:      ["-stdlib=libc++", "-std=c++17"]
            linkFlags:  ["-ObjC"]
            libs:       ["z", "c++", "sqlite3"]

    armv7-android:
        context:
            flags:      ["-std=c++17"]
            # Defold links every extension into one shared library, which can
            # only have one JNI_OnLoad. GADefold.cpp hands the JavaVM over instead.
            defines:    ["GA_NO_JNI_ONLOAD"]

    arm64-android:
        context:
            flags:      ["-std=c++17"]
            defines:    ["GA_NO_JNI_ONLOAD"]

    x86_64-osx:
        context:
            flags:      ["-std=c++17", "-stdlib=libc++"]
            linkFlags:  ["-stdlib=libc++"]
            # the frameworks libGameAnalytics.a links
            frameworks: ["CoreFoundation", "Foundation", "CoreServices", "SystemConfiguration", "Metal", "MetalKit"]

    arm64-osx:
        context:
            flags:      ["-std=c++17", "-stdlib=libc++"]
            linkFlags:  ["-stdlib=libc++"]
            frameworks: ["CoreFoundation", "Foundation", "CoreServices", "SystemConfiguration", "Metal", "MetalKit"]

    x86_64-linux:
        context:
            flags:      ["-std=c++17"]

    wasm-web:
        context:
            flags:      ["-std=c++17"]

    wasm_pthread-web:
        context:
            flags:      ["-std=c++17"]

    x86_64-win32:
        context:
            flags:      ["-std=c++17"]
